<!DOCTYPE html>
<html>
<head>
    <title>Student Information System</title>
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

       body {
            background-color: #0b0b14;
            font-family: Arial, sans-serif;
            display: flex;
            flex-direction: column;
            color: #e2e8f0;
        }

        header {
            background-color: #2e1065;
            color: #ffffff;
            text-align: center;
            padding: 25px 0 15px 0;
            box-shadow: 0 0 15px rgba(168, 85, 247, 0.4);
        }

        header h1 {
            margin: 0;
            font-size: 26px;
            letter-spacing: 1px;
            text-shadow: 0 0 8px #a855f7;
        }

        header p {
            margin: 4px 0 0 0;
            font-size: 13px;
            color: #c084fc;
        }

        .header-container {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px; 
        }   

        .header-logo {
            width: 50px; 
            height: auto;
        }

        .header-text {
            text-align: left;
        }

        nav {
            background-color: #0f172a;
            border-bottom: 2px solid #581c87;
        }

        nav ul {
            list-style: none;
            margin: 0;
            padding: 12px 0;
            display: flex;
            justify-content: center;
            gap: 25px;
        }

        nav li {
            color: #f1f5f9;
            font-weight: bold;
            font-size: 14px;
            letter-spacing: 0.5px;
        }

        main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 0;
        }

        .card {
            background-color: #161626;
            width: 90%;
            max-width: 800px;
            padding: 25px;
            border-radius: 8px;
            border: 1px solid #3b0764;
            box-shadow: 0 0 20px rgba(147, 51, 234, 0.2);
        }

        .card h2 {
            color: #c084fc;
            margin-top: 0;
            margin-bottom: 5px;
            text-shadow: 0 0 5px rgba(192, 132, 252, 0.3);
        }

        .card p {
            color: #94a3b8;
            margin-top: 0;
            margin-bottom: 20px;
            font-size: 13px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        th {
            background-color: #581c87;
            color: #ffffff;
            text-align: left;
            padding: 10px 12px;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        td {
            padding: 10px 12px;
            color: #e2e8f0;
            border-bottom: 1px solid #2e1065;
        }

        /* Centering the 5th column (Grade) and 1st column (No.) */
        th:nth-child(1), td:nth-child(1),
        th:nth-child(5), td:nth-child(5) {
            text-align: center;
        }

        tbody tr:nth-child(even) {
            background-color: #1e1b2e;
        }

        td:last-child {
            font-weight: bold;
            color: #a855f7;
        }

        td.passed {
            color: #4ade80; /* Bright green */
            font-weight: bold;
        }

        td.failed {
            color: #f87171; /* Bright red */
            font-weight: bold;
        }

        footer {
            background-color: #3b0764; 
            height: 40px;
            width: 100%;
            display: flex;
            justify-content: center; 
            align-items: center;     
            color: #e9d5ff;
            font-size: 13px;
            box-shadow: 0 -2px 10px rgba(168, 85, 247, 0.3);
        }

        footer p {
            margin: 0;
        }
  </style>
</head>
<body>

    <header>
